@model ClientLoad
@using ACT.Core.Enums
@using ACT.Data.Models;
@{
    if ( ViewBag.IncludeLayout == null )
    {
        Layout = null;
    }
    ViewBag.Title = "Client Data Details";
    List<ClientLoad> clientLoads = ViewBag.ClientLoads;
}
@if ( ViewBag.IncludeLayout != null )
{
    <h2>
        <img alt="" src="@Url.Content( "~/images/info.png" )" />
        <span>Client Data Details</span>
    </h2>
}
<div id="item-details" class="item-details" style="width: auto;">
    @if ( ViewBag.IncludeLayout == null )
    {
        <h2>
            <img alt="" src="@Url.Content( "~/images/info.png" )" />
            <span>Dispute Details</span>
        </h2>
    }
    <div class="left" style="width: 31%; margin-right: 3%;">
        <div class="form-group">
            <div class="display-label">
                Client:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.Client.CompanyName )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Load Number:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.LoadNumber )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Load Date:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.LoadDate )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Supplier From:
            </div>
            <div class="display-field">
                @(ViewBag.SupplierSiteOptions.ContainsKey(Model.ClientSiteId ?? 0)
                ? ViewBag.SupplierSiteOptions[Model.ClientSiteId ?? 0]
                : "N/A")
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Region From:
            </div>
            <div class="display-field">
                N/A
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Customer To:
            </div>
            <div class="display-field">
                @(ViewBag.CustomerSiteOptions.ContainsKey(Model.ToClientSiteId ?? 0)
                ? ViewBag.CustomerSiteOptions[Model.ToClientSiteId ?? 0]
                : "N/A")
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Region To:
            </div>
            <div class="display-field">
                N/A
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Customer Group:
            </div>
            <div class="display-field">
                @{
                    var groupName = "N/A";
                    if ( ViewBag.ClientGroupId != null && ViewBag.ClientGroupOptions != null )
                    {
                        int groupId = ( int ) ViewBag.ClientGroupId;
                        if ( ViewBag.ClientGroupOptions.ContainsKey( groupId ) )
                        {
                            groupName = ViewBag.ClientGroupOptions[ groupId ];
                        }
                    }
                }
                @groupName
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Delivery Note:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.DeliveryNote )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                CHEP Invoice No:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.ChepInvoiceNo )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Order Number:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.OrderNumber )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Primary/Secondary:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.LoadType )
            </div>
        </div>
    </div>
    <div class="left" style="width: 31%; margin-right: 3%;">
        <div class="form-group">
            <div class="display-label">
                Depo STO No:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.DepoSTONo )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                GLID:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.GLID )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Delivery Date:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.DeliveryDate )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Transporter:
            </div>
            <div class="display-field">
                @(ViewBag.TransporterOptions.ContainsKey(Model.TransporterId ?? 0)
                ? ViewBag.TransporterOptions[Model.TransporterId ?? 0]
                : "N/A")
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Fleet Number:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.Vehicle.FleetNumber )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Vehicle Registration:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.Vehicle.Registration )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Debtors Code:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.DebtorsCode )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Customer Account Number:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.AccountNumber )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Customer Order Number:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.OrderNumber )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Reference Number:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.ReferenceNumber )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Loadsheet No:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.LoadSheetNo )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Receiver Number:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.ReceiverNumber )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                GRV Number:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.GRVNumber )
            </div>
        </div>
    </div>
    <div class="left" style="width: 31%;">
        <div class="form-group">
            <div class="display-label">
                Doc Number:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.DocNumber )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Exchange No:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.ExchangeNo )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                CHEP Customer Than Doc No:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.ChepCustomerThanDocNo )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Warehouse Transfer Doc No:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.WarehouseTransferDocNo )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Debrief Docket No:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.DebriefDocketNo )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Pallet Return Slip No:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.PalletReturnSlipNo )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Pallet Return Date:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.PalletReturnDate )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Authorization Code:
            </div>
            <div class="display-field">
                @if ( Model.ClientAuthorisations != null && Model.ClientAuthorisations.Any() )
                {
                    @Html.DisplayFor( model => model.ClientAuthorisations.First().Code )
                }
                else
                {
                    <span>No authorization available</span>
                }
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Authorized By:
            </div>
            <div class="display-field">
                @if ( Model.ClientAuthorisations != null && Model.ClientAuthorisations.Any() && Model.ClientAuthorisations.First().User != null )
                {
                    @Html.DisplayFor( model => model.ClientAuthorisations.First().User.Name )
                    @Html.DisplayFor( model => model.ClientAuthorisations.First().User.Surname )
                }
                else
                {
                    <span>No authorizing user available</span>
                }
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                CHEP Compensation No:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.ChepCompensationNo )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Compensation Date:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.CompensationDate )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Effective Date:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.EffectiveDate )
            </div>
        </div>
        <div class="form-group">
            <div class="display-label">
                Status:
            </div>
            <div class="display-field">
                @Html.DisplayFor( model => model.Status )
            </div>
        </div>
    </div>

    <div class="clear" style="border-bottom: 1px dashed #ccc; margin-bottom: 20px;">&nbsp;</div>

    <div class="grouped-area">
        <div id="equipment-detailed-view-container">
            <div class="equipment-detail-section" style="margin-top: 35px !important">
                <p>
                    <strong class="uppercase">Equipment Details</strong>
                </p>

                @{
                    var equipmentDetails = Model.ClientLoadQuantities?.ToList() ?? new List<ClientLoadQuantity>();
                    var clientProducts = ViewBag.ClientProducts as List<ClientProduct> ?? new List<ClientProduct>();
                    var equipmentCodeOptions = ViewBag.EquipmentCodeOptions as Dictionary<int, string> ?? new Dictionary<int, string>();

                    for ( int section = 0; section < ( equipmentDetails.Count + 2 ) / 3; section++ )
                    {
                        <div class="editor-label" style="margin-top: 15px !important">
                            <label>Equipment</label>
                        </div>
                        <div class="editor-field">
                            @for ( int i = 0; i < 3 && ( section * 3 + i ) < equipmentDetails.Count; i++ )
                            {
                                var currentEquipmentCode = equipmentDetails[ section * 3 + i ].EquipmentCode;
                                var currentProductId = clientProducts.FirstOrDefault( cp => cp.Equipment == currentEquipmentCode )?.ProductId ?? 0;
                                <div style="display: inline-block; margin-right: 10px; width: 32%;">
                                    @Html.DropDownList( $"ProductId_{section * 3 + i}",
                                        new SelectList( equipmentCodeOptions, "Key", "Value", currentProductId ),
                                        "Select Equipment",
                                        new { @class = "chzn equipment-dropdown", @style = "width: 100%;" } )
                                </div>
                            }
                        </div>

                        <div class="editor-label" style="margin-top: 15px !important">
                            <label>Delivered Quantity</label>
                        </div>
                        <div class="editor-field">
                            @for ( int i = 0; i < 3 && ( section * 3 + i ) < equipmentDetails.Count; i++ )
                            {
                                <div style="display: inline-block; margin-right: 10px; width: 32%;">
                                    @Html.TextBox( $"OriginalQuantity_{section * 3 + i}", equipmentDetails[ section * 3 + i ].OriginalQuantity, new { @class = "input", @style = "width: 100%;" } )
                                </div>
                            }
                        </div>

                        <div class="editor-label" style="margin-top: 15px !important">
                            <label>Returned/Transferred Quantity</label>
                        </div>
                        <div class="editor-field">
                            @for ( int i = 0; i < 3 && ( section * 3 + i ) < equipmentDetails.Count; i++ )
                            {
                                <div style="display: inline-block; margin-right: 10px; width: 32%;">
                                    @Html.TextBox( $"ReturnQty_{section * 3 + i}", equipmentDetails[ section * 3 + i ].ReturnQty, new { @class = "input", @style = "width: 100%;" } )
                                </div>
                            }
                        </div>

                        <div class="editor-label" style="margin-top: 15px !important">
                            <label>Debrief Quantity</label>
                        </div>
                        <div class="editor-field">
                            @for ( int i = 0; i < 3 && ( section * 3 + i ) < equipmentDetails.Count; i++ )
                            {
                                <div style="display: inline-block; margin-right: 10px; width: 32%;">
                                    @Html.TextBox( $"DebriefQty_{section * 3 + i}", equipmentDetails[ section * 3 + i ].DebriefQty, new { @class = "input", @style = "width: 100%;" } )
                                </div>
                            }
                        </div>

                        <div class="editor-label" style="margin-top: 15px !important">
                            <label>Transporter Liable</label>
                        </div>
                        <div class="editor-field">
                            @for ( int i = 0; i < 3 && ( section * 3 + i ) < equipmentDetails.Count; i++ )
                            {
                                <div style="display: inline-block; margin-right: 10px; width: 32%;">
                                    @Html.TextBox( $"TransporterLiableQty_{section * 3 + i}", equipmentDetails[ section * 3 + i ].TransporterLiableQty, new { @class = "input", @style = "width: 100%;" } )
                                </div>
                            }
                        </div>

                        <div class="editor-label" style="margin-top: 15px !important">
                            <label>Admin Movement</label>
                        </div>
                        <div class="editor-field">
                            @for ( int i = 0; i < 3 && ( section * 3 + i ) < equipmentDetails.Count; i++ )
                            {
                                <div style="display: inline-block; margin-right: 10px; width: 32%;">
                                    @Html.TextBox( $"AdminMovementQty_{section * 3 + i}", equipmentDetails[ section * 3 + i ].AdminMovementQty, new { @class = "input", @style = "width: 100%;" } )
                                </div>
                            }
                        </div>

                        <div class="editor-label" style="margin-top: 15px !important">
                            <label>Outstanding Quantity</label>
                        </div>
                        <div class="editor-field">
                            @for ( int i = 0; i < 3 && ( section * 3 + i ) < equipmentDetails.Count; i++ )
                            {
                                <div style="display: inline-block; margin-right: 10px; width: 32%;">
                                    @Html.TextBox( $"OutstandingQty_{section * 3 + i}", equipmentDetails[ section * 3 + i ].OutstandingQty, new { @class = "input", @style = "width: 100%;" } )
                                </div>
                            }
                        </div>

                        if ( section < ( equipmentDetails.Count + 2 ) / 3 - 1 )
                        {
                            <div class="clear" style="border-bottom: 1px dashed #ccc; margin-bottom: 20px; margin-top: 20px; height: 0;">&nbsp;</div>
                        }
                    }
                }
            </div>
            <div class="clear" style="border-bottom: 1px dashed #ccc; margin-bottom: 20px; margin-top: 20px; height: 0;">&nbsp;</div>
        </div>
    </div>

    <div class="clear" style="border-bottom: 1px dashed #ccc; margin-bottom: 20px;">&nbsp;</div>

    @if ( ViewBag.IncludeLayout == null )
    {
        <p>
            @Html.ActionLink( "Edit", "EditClientData", new { id = Model.Id }, new { @class = "edit", @data_edit = "1", @data_id = Model.Id, @data_target = "#tr-" + Model.Id + "-item" } )
            @if ( ViewBag.IncludeLayout == null )
            {
                <span style="padding: 0 5px;">/</span>
                <a data-cancel="1" data-target="#item-details" data-remove="tr.edit">Cancel</a>
            }
        </p>
    }
    @if ( ViewBag.IncludeLayout != null )
    {
        <div class="back-to-list">
            @Html.ActionLink( "Back to List", "Index" )
        </div>
    }
</div>
<style>
    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .display-label {
        width: 160px;
        margin-right: 10px;
        margin-bottom: 8px;
    }

    .display-field {
        flex-grow: 1;
    }

    .chzn {
        width: 100%;
    }
</style>