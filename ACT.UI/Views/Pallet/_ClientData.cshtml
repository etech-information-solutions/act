@model PagingExtension

@using ACT.Core.Enums;
@using ACT.Core.Models.Custom;

@{
    ViewBag.ShowExport = true;
    ViewBag.ShowCustom = true;

    ViewBag.ViewName = "_ClientData";
}


@Html.Partial( "_Notification" )


@{
    int count = Model.Start;

    List<ClientLoadCustomModel> items = ( List<ClientLoadCustomModel> ) Model.Items;
}


@if ( Model == null || !items.Any() )
{
    <div class="notification message-warn" style="margin-bottom: 20px;">
        There are no Client Load Entries available matching your search criteria.
    </div>
}

<p>
    @Html.ActionLink( "Add", "AddClientData", new { }, new { @class = "add", @rel = "tipsyS", @title = "Add Manual Client Data?", @data_edit = "1", @data_id = 0, @data_target = "#clientdata" } )

    <span style="padding: 0 5px;">|</span>

    @Html.ActionLink( "Import", "ImportClientData", new { }, new { @class = "csv", @rel = "tipsyS", @title = "Import Client Data?", @data_edit = "1", @data_id = 0, @data_target = "#clientdata" } )

    <span class="loader"></span>
</p>

<table id="ClientData-table" class="da-table datatable-numberpaging sort fixed-header" data-fixed-header-target="#ClientData-table_wrapper" data-starting-point=".ap-tabs ul">
    <thead>
        <tr>
            <th data-name="Count">
                #
            </th>
            <th data-name="LoadDate" data-column="cl.LoadDate">
                Load Date
            </th>
            <th data-name="Client" data-column="c.Client">
                Client Name
            </th>
            <th data-name="SupplierFrom" data-column="cs1.Description">
                Supplier From
            </th>
            <th data-name="CustomerTo" data-column="cs2.Description">
                Customer To
            </th>
            <th data-name="CustomerGroup" data-column="g.Name">
                Customer Group
            </th>
            <th data-name="" data-column="">
                Load/Shipment
            </th>
            <th data-name="" data-column="">
                Transporter Name
            </th>
            <th data-name="" data-column="">
                Status
            </th>
            <th data-name="Actions">
                Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @if ( Model != null && items != null && items.Count() > 0 )
        {
            foreach ( var item in items )
            {
                Status status = ( Status ) item.Status;
                string active = ( status == Status.Active ) ? "active" : "inactive";
                string enable = ( status == Status.Active ) ? "Disable" : "Enable";

                <tr id="clientdata-@item.Id-item" class="clientdata-@item.Id-item ">
                    <td>
                        @count
                    </td>
                    <td>
                        @(item.LoadDate?.ToString( "yyyy-MM-dd" ))
                    </td>
                    <td>
                        @item.ClientName
                    </td>
                    <td>
                        @item.SupplierFrom
                    </td>
                    <td>
                        @item.CustomerTo
                    </td>
                    <td>
                        @item.CustomerGroup
                    </td>
                    <td>
                        @item.LoadNumber
                    </td>
                    <td>
                        @item.TransporterName
                    </td>
                    <td>
                        @status.GetDisplayText()
                    </td>
                    <td width="15%">

                        <div style="border-bottom: 1px dashed #7368e3; padding-bottom: 4px; margin-bottom: 10px;">

                            @Html.ActionLink( "Details", "ClientDataDetails", new { id = item.Id }, new { @class = "info", @data_details = "1", @data_id = item.Id, @data_target = ".clientdata-" + item.Id + "-item" } )

                            @Html.ActionLink( "Edit", "EditClientData", new { id = item.Id, returnView = "Pallet" }, new { @class = "edit", @data_edit = "1", @data_id = item.Id, @data_target = ".clientdata-" + item.Id + "-item" } )

                            @Html.ActionLink( enable, "DeleteClientData", new { id = item.Id }, new { @class = "warn", @data_delete = "1", @data_id = item.Id, @data_target = "#tr-" + item.Id + "-item", @data_refresh_target = "#clientdata", @rel = "tipsyE", @title = enable + " this item?" } )

                        </div>
                    </td>
                </tr>
                
                count++;
            }
        }
    </tbody>

</table>

@Html.Partial( "_Paging" )