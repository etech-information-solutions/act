@model ClientLoadViewModel

@using ACT.UI.Models;
@using ACT.Core.Enums;

@{
    if ( ViewBag.IncludeLayout == null )
    {
        Layout = null;
    }

    ViewBag.Title = "Add Client Load";
}

@Html.Partial( "_Notification" )


@using ( Html.BeginForm( "AddClientData", "Pallet", FormMethod.Post, new { enctype = "multipart/form-data", @data_ajax_form = "1", @data_target = "#clientdata", @class = "custom-validate", @style = "width: auto;" } ) )
{
    <div id="edit-item">

        <h2 class="" style="width: auto;">
            <img alt="" src="@Url.Content("~/images/add.png")" />
            <span>Add Client Load</span>
        </h2>

        @Html.ValidationSummary( true )

        <div id="item-details" class="item-details" style="width: auto;">

            <div class="left" style="width: 31%; margin-right: 3%;">
                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ClientId )
                    </div>
                    <div class="editor-field">
                        @Html.DropDownListFor( model => model.ClientId,
                            new SelectList( Model.ClientOptions, "Key", "Value" ),
                            "Select Client",
                            new { @class = "chzn" } )
                        @Html.ValidationMessageFor( model => model.ClientId )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.LoadNumber )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.LoadNumber, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.LoadNumber )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.LoadDate )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.LoadDate, new { @class = "date-picker", @placeholder = "     /       /       " } )
                        @Html.ValidationMessageFor( model => model.LoadDate )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ClientSiteId )
                    </div>
                    <div class="editor-field" data-populate-region="1">
                        @Html.DropDownListFor( model => model.ClientSiteId,
                            new SelectList( Model.SupplierSiteOptions, "Key", "Value" ),
                            "Select Supplier From",
                            new
                            {
                                @class = "chzn",
                                @style = "width: 98%;",
                                @data_populate_region = "1",
                                @data_is_supplier = "true",
                                @data_region_id_field = "#RegionFromId",
                                @data_region_name_field = "#RegionFromName"
                            } )
                        @Html.ValidationMessageFor( model => model.ClientSiteId )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.RegionFromId )
                    </div>
                    <div class="editor-field">
                        @Html.HiddenFor( model => model.RegionFromId )
                        @Html.TextBoxFor( model => model.RegionFromName, new { @readonly = "readonly", @placeholder = "Field Auto Generated" } )
                        @Html.ValidationMessageFor( model => model.RegionFromId )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ClientSiteIdTo )
                    </div>
                    <div class="editor-field" data-populate-region="1">
                        @Html.DropDownListFor( model => model.ClientSiteIdTo,
                            new SelectList( Model.CustomerSiteOptions, "Key", "Value" ),
                            "Select Customer To",
                            new
                                 {
                                @class = "chzn",
                                @style = "width: 98%;",
                                @data_populate_region = "1",
                                @data_is_supplier = "false",
                                @data_region_id_field = "#RegionToId",
                                @data_region_name_field = "#RegionToName"
                            } )
                        @Html.ValidationMessageFor( model => model.ClientSiteIdTo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.RegionToId )
                    </div>
                    <div class="editor-field">
                        @Html.HiddenFor( model => model.RegionToId )
                        @Html.TextBoxFor( model => model.RegionToName, new { @readonly = "readonly", @placeholder = "Field Auto Generated" } )
                        @Html.ValidationMessageFor( model => model.RegionToId )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ClientGroupId )
                    </div>
                    <div class="editor-field">
                        @Html.DropDownListFor( model => model.ClientGroupId, new SelectList( Model.ClientGroupOptions, "Key", "Value" ), "Select Customer Group", new { @class = "chzn", @style = "width: 98%;" } )
                        @Html.ValidationMessageFor( model => model.ClientGroupId )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.DeliveryNote )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.DeliveryNote, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.DeliveryNote )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ChepInvoiceNo )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.ChepInvoiceNo, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.ChepInvoiceNo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.OrderNumber )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.OrderNumber, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.OrderNumber )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.PrimarySecondary )
                    </div>
                    <div class="editor-field">
                        @Html.DropDownListFor( model => model.PrimarySecondary,
                            new SelectList( Enum.GetValues( typeof( LoadType ) )
                                .Cast<LoadType>()
                                .Select( e => new SelectListItem
                                {
                                    Text = e.ToString(),
                                    Value = ( ( int ) e ).ToString()
                                } ), "Value", "Text" ),
                            "Select Primary/Secondary",
                            new { @class = "chzn", @style = "width: 98%;" } )
                        @Html.ValidationMessageFor( model => model.PrimarySecondary )
                    </div>
                </div>

            </div>

            <div class="left" style="width: 31%; margin-right: 3%;">

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.DepoSTONo )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.DepoSTONo, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.DepoSTONo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.GLID )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.GLID, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.GLID )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.DeliveryDate )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.DeliveryDate, new { @class = "date-picker", @placeholder = "     /       /       " } )
                        @Html.ValidationMessageFor( model => model.DeliveryDate )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.TransporterId )
                    </div>
                    <div class="editor-field">
                        @Html.DropDownListFor( model => model.TransporterId, new SelectList( Model.TransporterOptions, "Key", "Value" ), "Select Transporter", new { @class = "chzn", @style = "width: 98%;" } )
                        @Html.ValidationMessageFor( model => model.TransporterId )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.FleetNumber )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.FleetNumber, new { @class = "input", @readonly = "readonly", @placeholder = "Field auto generated" } )
                        @Html.ValidationMessageFor( model => model.FleetNumber )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.VehicleRegistration )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.VehicleRegistration, new { @class = "input", @readonly = "readonly", @placeholder = "Field auto generated" } )
                        @Html.ValidationMessageFor( model => model.VehicleRegistration )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.DebtorsCode )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.DebtorsCode, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.DebtorsCode )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.CustomerAccountNumber )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.CustomerAccountNumber, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.CustomerAccountNumber )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.CustomerOrderNumber )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.CustomerOrderNumber, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.CustomerOrderNumber )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ReferenceNumber )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.ReferenceNumber, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.ReferenceNumber )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.LoadsheetNo )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.LoadsheetNo, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.LoadsheetNo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ReceiverNumber )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.ReceiverNumber, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.ReceiverNumber )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.GRVNumber )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.GRVNumber, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.GRVNumber )
                    </div>
                </div>
            </div>

            <div class="left" style="width: 31%;">
                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.DocNumber )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.DocNumber, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.DocNumber )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ExchangeNo )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.ExchangeNo, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.ExchangeNo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ChepCustomerThanDocNo )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.ChepCustomerThanDocNo, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.ChepCustomerThanDocNo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.WarehouseTransferDocNo )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.WarehouseTransferDocNo, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.WarehouseTransferDocNo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.DebriefDocketNo )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.DebriefDocketNo, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.DebriefDocketNo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.PalletReturnSlipNo )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.PalletReturnSlipNo, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.PalletReturnSlipNo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.PalletReturnDate )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.PalletReturnDate, new { @class = "date-picker", @placeholder = "     /       /       " } )
                        @Html.ValidationMessageFor( model => model.PalletReturnDate )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.AuthorizationCode )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.AuthorizationCode, new { @class = "input", @placeholder = "Field Auto Generated", @readonly = "readonly" } )
                        @Html.ValidationMessageFor( model => model.AuthorizationCode )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.AuthorizedBy )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.AuthorizedBy, new { @class = "input", @placeholder = "Field Auto Generated", @readonly = "readonly" } )
                        @Html.ValidationMessageFor( model => model.AuthorizedBy )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.ChepCompensationNo )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.ChepCompensationNo, new { @class = "input", @placeholder = "Please Complete" } )
                        @Html.ValidationMessageFor( model => model.ChepCompensationNo )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.CompensationDate )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.CompensationDate, new { @class = "date-picker", @placeholder = "     /       /       " } )
                        @Html.ValidationMessageFor( model => model.CompensationDate )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.EffectiveDate )
                    </div>
                    <div class="editor-field">
                        @Html.TextBoxFor( model => model.EffectiveDate, new { @class = "date-picker", @placeholder = "     /       /       " } )
                        @Html.ValidationMessageFor( model => model.EffectiveDate )
                    </div>
                </div>

                <div class="form-group">
                    <div class="editor-label">
                        @Html.LabelFor( model => model.Status )
                    </div>
                    <div class="editor-field">
                        @Html.EnumDropDownListFor( model => model.Status, "-- Select Status --", new { @class = "chzn" } )
                        @Html.ValidationMessageFor( model => model.Status )
                    </div>
                </div>

            </div>

            <div class="clear" style="border-bottom: 1px dashed #ccc; margin-bottom: 20px;">&nbsp;</div>

            <div class="left grouped-area" style="width: 55%; margin-right: 3%;">

                <div id="equipment-details-container">
                    @Html.Partial( "_EquipmentDetails", Model )

                    <div class="clear" style="margin-bottom: 20px; margin-top: 20px; height: 0;">&nbsp;</div>
                </div>

                <div style="position: relative;">
                    <a data-add-section="1" data-target="#equipment-details-container" rel="tipsyW" title="Add another Section?" style="background: #ece0e0; padding: 8px 10px; position: absolute; left: -35px; border-radius: 18px;">
                        <img alt="Add" src="@Url.Content("~/Images/add.png")" />
                    </a>
                </div>

            </div>

            <div class="left grouped-area" style="width: 30%;">
                <p>
                    <strong class="uppercase">Load Comments</strong>
                </p>
                <div class="form-group">
                    <div class="editor-label comment-label">
                        Document Type:
                    </div>
                    <div class="editor-field comment-field">
                        @Html.EnumDropDownFor( model => model.DocumentType, false, true, new { @class = "chzn", @style = "width: 100%;" } )
                    </div>
                </div>
                <div class="form-group">
                    <div class="editor-label comment-label">
                        Load Type
                    </div>
                    <div class="editor-field comment-field">
                        @{
                            string ltype = "THAN";

                            if ( Model?.CustomerType?.ToUpper()?.Contains( "EXCHANGE" ) == true || Model.ReceiverNumber?.StartsWith( "50000" ) == true || Model.ReceiverNumber?.StartsWith( "52" ) == true || Model.ReceiverNumber?.StartsWith( "51" ) == true )
                            {
                                ltype = "PCN";
                            }
                            else if ( Model.DocumentType == DocumentType.ACTControlDoc )
                            {
                                ltype = "OTHER";
                            }
                        }
                        @Html.Raw( ltype )
                    </div>
                </div>
                <div class="form-group">
                    <div class="editor-label comment-label">
                        Load Comment:
                    </div>
                    <div class="editor-field comment-field">
                        @Html.DropDownListFor( model => model.PODCommentId, model => Model.PODCommentOptions, p => p.Key, p => p.Value, true, new { @class = "chzn", @style = "width: 100%;" } )
                    </div>
                </div>
                <div class="form-group">
                    <div class="editor-label comment-label">
                        Pallet Notes:
                    </div>
                    <div class="editor-field comment-field">
                        @Html.TextAreaFor( model => model.ClientLoadNotes, 5, 10, new { @class = "input", @placeholder = "Please Complete" } )
                    </div>
                </div>

            </div>

            <div class="clear" style="border-bottom: 1px dashed #ccc; margin-bottom: 20px;">&nbsp;</div>

            <p>
                <input id="save-btn" type="submit" value="Save" />

                <span style="padding: 0 5px;">/</span>

                <a data-refresh="1" data-target="#clientdata">Cancel</a>
            </p>

        </div>

    </div>
}

<style>
    .form-group {
        display: flex;
        align-items: center;
    }

    .editor-label {
        width: 120px;
        margin-right: 10px;
    }

    .editor-field {
        flex-grow: 1;
    }

    .comment-label {
        margin-bottom: 30px;
    }

    .comment-field {
        margin-bottom: 35px !important;
    }

    .chzn {
        width: 100%;
    }
</style>