@model PagingExtension

@using ACT.Core.Enums;
@using ACT.Core.Models;
@using ACT.Core.Models.Custom;

@{
    ViewBag.ShowExport = true;
    ViewBag.ShowCustom = true;
    ViewBag.ViewName = "_ManageCustomerSites";
}

@Html.Partial( "_Notification" )

@{
    UserModel user = User.Get();
    int count = Model.Start;
    List<SiteCustomModel> items = ( List<SiteCustomModel> ) Model.Items;
}

@if ( Model == null || !items.Any() )
{
    <div class="notification message-warn" style="margin-bottom: 20px;">
        There are no Customer Sites available matching your search criteria.
    </div>
}

<p>
    @Html.ActionLink( "Add", "AddCustomerSite", new { }, new { @class = "add", @rel = "tipsyS", @title = "Add a new Customer Site?", @data_edit = "1", @data_id = 0, @data_target = "#managecustomersites" } )
    <span style="padding: 0 5px;">|</span>
    @Html.ActionLink( "Import", "ImportCustomerSite", new { }, new { @class = "csv", @rel = "tipsyS", @title = "Import new Customer Sites?", @data_edit = "1", @data_id = 0, @data_target = "#managecustomersites" } )
    <span class="loader"></span>
</p>

<table id="sites-table" class="da-table datatable-numberpaging sort fixed-header" data-fixed-header-target="#sites-table_wrapper" data-starting-point=".ap-tabs ul">
    <thead>
        <tr>
            <th data-name="Count">#</th>
            <th data-name="CreatedOn" data-column="s.CreatedOn">Date</th>
            <th data-name="ClientName" data-column="c.CompanyName">Client</th>
            <th data-name="CustomerName" data-column="cc.CustomerName">Customer</th>
            <th data-name="SiteName" data-column="s.Name">Site Name</th>
            <th data-name="SubSite">Sub Site</th>
            <th data-name="RegionName" data-column="r.Name">Region</th>
            <th data-name="Status" data-column="s.Status">Status</th>
            <th data-name="Actions">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if ( Model != null && items != null && items.Count() > 0 )
        {
            foreach ( SiteCustomModel item in items )
            {
                Status status = ( Status ) item.Status;
                string active = ( status == Status.Active ) ? "active" : "inactive";
                string enable = ( status == Status.Active ) ? "Disable" : "Enable";

                <tr id="tr-@item.Id-item" class="tr-@item.Id-item @active">
                    <td width="1%">@count</td>
                    <td>
                        @item.CreatedOn.ToString( "yyyy-MM-dd" )
                        <a class="block" rel="tipsyE" title="Review audit log" data-audit-log="1" data-pid="@item.Id" data-type="CustomerSite">
                            <img alt="" src="@Url.Content("~/Images/duplicate-content.png")" style="max-width: 15px;" />
                            <span></span>
                        </a>
                    </td>
                    <td>@item.ClientName</td>
                    <td>
                        @if ( !string.IsNullOrEmpty( item.CustomerName ) )
                        {
                            @item.CustomerName
                        }
                        else
                        {
                            <span>No Customer Selected</span>
                        }
                    </td>
                    <td>@item.MainSite</td>
                    <td>
                        @if ( !string.IsNullOrEmpty( item.OptionalSite ) )
                        {
                            @item.OptionalSite
                        }
                        else
                        {
                            <span>No Optional Site</span>
                        }
                    </td>
                    <td>@item.RegionName</td>
                    <td>@status.GetDisplayText()</td>
                    <td width="15%">
                        <div style="border-bottom: 1px dashed #7368e3; padding-bottom: 4px; margin-bottom: 10px;">
                            @Html.ActionLink( "Details", "CustomerSiteDetails", new { id = item.Id }, new { @class = "info", @data_details = "1", @data_id = item.Id, @data_target = ".tr-" + item.Id + "-item" } )
                            @Html.ActionLink( "Edit", "EditCustomerSite", new { id = item.Id, returnView = "managecustomersites" }, new { @class = "edit", @data_edit = "1", @data_id = item.Id, @data_target = ".tr-" + item.Id + "-item" } )
                            @Html.ActionLink( enable, "DeleteCustomerSite", new { id = item.Id }, new { @class = "warn", @data_delete = "1", @data_id = item.Id, @data_target = "#tr-" + item.Id + "-item", @data_refresh_target = "#managecustomersites", @rel = "tipsyE", @title = enable + " this item?" } )
                        </div>
                    </td>
                </tr>
                count++;
            }
        }
    </tbody>
</table>

@Html.Partial( "_Paging" )