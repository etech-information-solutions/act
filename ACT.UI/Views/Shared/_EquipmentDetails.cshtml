@model ACT.UI.Models.ClientLoadViewModel
@for ( int section = 0; section < ( Model.EquipmentDetails.Count + 2 ) / 3; section++ )
{
    <div class="equipment-detail-section">
        <p>
            <strong class="uppercase">Equipment Details</strong>
        </p>
        <div class="form-group">
            <div class="editor-label">
                @Html.LabelFor( m => m.EquipmentDetails[ 0 ].ProductId )
            </div>
            <div class="editor-field">
                @for ( int i = 0; i < 3 && ( section * 3 + i ) < Model.EquipmentDetails.Count; i++ )
                {
                    var index = section * 3 + i;
                    <div style="display: inline-block; width: 30% !important;">
                        @Html.DropDownListFor(
                            m => m.EquipmentDetails[ index ].ProductId,
                            new SelectList(
                                Model.EquipmentDetails[ index ].ProductOptions,
                                "Key",
                                "Value",
                                Model.EquipmentDetails[ index ].ProductId
                            ),
                            "Select Equipment",
                            new { @class = "equipment-dropdown", @style = "width: 100%; margin-bottom: 15px !important", data_index = index }
                        )
                    </div>
                }
            </div>
        </div>
        <div class="form-group">
            <div class="editor-label">
                @Html.LabelFor( m => m.EquipmentDetails[ 0 ].DeliveredQty )
            </div>
            <div class="editor-field">
                @for ( int i = 0; i < 3 && ( section * 3 + i ) < Model.EquipmentDetails.Count; i++ )
                {
                    @Html.TextBoxFor( m => m.EquipmentDetails[ section * 3 + i ].DeliveredQty, new { @class = "input", @style = "width: 25%; margin-right: 5px; margin-bottom: 8px; margin-top: 10px" } )
                }
            </div>
        </div>
        <div class="form-group">
            <div class="editor-label">
                @Html.LabelFor( m => m.EquipmentDetails[ 0 ].ReturnedTransferredQty )
            </div>
            <div class="editor-field">
                @for ( int i = 0; i < 3 && ( section * 3 + i ) < Model.EquipmentDetails.Count; i++ )
                {
                    @Html.TextBoxFor( m => m.EquipmentDetails[ section * 3 + i ].ReturnedTransferredQty, new { @class = "input", @style = "width: 25%; margin-right: 5px; margin-bottom: 8px" } )
                }
            </div>
        </div>
        <div class="form-group">
            <div class="editor-label">
                @Html.LabelFor( m => m.EquipmentDetails[ 0 ].DebriefQty )
            </div>
            <div class="editor-field">
                @for ( int i = 0; i < 3 && ( section * 3 + i ) < Model.EquipmentDetails.Count; i++ )
                {
                    @Html.TextBoxFor( m => m.EquipmentDetails[ section * 3 + i ].DebriefQty, new { @class = "input", @style = "width: 25%; margin-right: 5px; margin-bottom: 8px" } )
                }
            </div>
        </div>
        <div class="form-group">
            <div class="editor-label">
                @Html.LabelFor( m => m.EquipmentDetails[ 0 ].TransporterLiable )
            </div>
            <div class="editor-field">
                @for ( int i = 0; i < 3 && ( section * 3 + i ) < Model.EquipmentDetails.Count; i++ )
                {
                    @Html.TextBoxFor( m => m.EquipmentDetails[ section * 3 + i ].TransporterLiable, new { @class = "input", @style = "width: 25%; margin-right: 5px; margin-bottom: 8px" } )
                }
            </div>
        </div>
        <div class="form-group">
            <div class="editor-label">
                @Html.LabelFor( m => m.EquipmentDetails[ 0 ].AdminMovement )
            </div>
            <div class="editor-field">
                @for ( int i = 0; i < 3 && ( section * 3 + i ) < Model.EquipmentDetails.Count; i++ )
                {
                    @Html.TextBoxFor( m => m.EquipmentDetails[ section * 3 + i ].AdminMovement, new { @class = "input", @style = "width: 25%; margin-right: 5px; margin-bottom: 8px" } )
                }
            </div>
        </div>
        <div class="form-group">
            <div class="editor-label">
                @Html.LabelFor( m => m.EquipmentDetails[ 0 ].OutstandingQtyAtCustomer )
            </div>
            <div class="editor-field">
                @for ( int i = 0; i < 3 && ( section * 3 + i ) < Model.EquipmentDetails.Count; i++ )
                {
                    @Html.TextBoxFor( m => m.EquipmentDetails[ section * 3 + i ].OutstandingQtyAtCustomer, new { @class = "input", @style = "width: 25%; margin-right: 5px; margin-bottom: 8px" } )
                }
            </div>
        </div>
    </div>
    if ( section < ( Model.EquipmentDetails.Count + 2 ) / 3 - 1 )
    {
        <div class="clear" style="border-bottom: 1px dashed #ccc; margin-bottom: 20px; margin-top: 20px; height: 0;">&nbsp;</div>
    }
}
